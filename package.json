{
  "name": "beacon",
  "version": "0.3.0",
  "description": "A guardrail for AI coding agents: per-branch front-end scope declarations, real-time flags on out-of-scope writes, and one-click revert before the PR.",
  "type": "module",
  "main": "src/main/main.js",
  "bin": {
    "beacon": "bin/beacon.mjs"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "author": "Stefan Rhoades",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneseventy170/Beacon.git"
  },
  "homepage": "https://github.com/oneseventy170/Beacon#readme",
  "bugs": {
    "url": "https://github.com/oneseventy170/Beacon/issues"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.beacon.app",
    "productName": "Beacon",
    "files": [
      "src/**/*",
      "bin/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "icons/lighthouse-glass-1024.png",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
